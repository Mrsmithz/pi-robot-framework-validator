#!/usr/bin/env node
const fs = require("node:fs");

if (process.argv[2] !== "check") {
  process.stderr.write(`Unexpected Robocop command: ${process.argv.slice(2).join(" ")}\n`);
  process.exit(2);
}

const output = process.argv.find((argument) => argument.startsWith("json_report.output_path="));
if (!output) {
  process.stderr.write("Missing JSON report output path.\n");
  process.exit(2);
}

const reportPath = output.slice("json_report.output_path=".length);
fs.writeFileSync(reportPath, JSON.stringify([{
  source: "tests/example.robot",
  line: 2,
  rule_id: "FIXTURE001",
  description: "Synthetic Robocop fixture finding.",
}]));
process.exit(1);
